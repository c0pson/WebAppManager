/* Application-wide defaults */
QWidget {
    color: #ffffff;
}

/* Bookmark Widget */
QWidget#bookmark {
    background-color: #e74c3c;
    border-radius: 6px;
}

QWidget#bookmark:hover {
    background-color: #c0392b;
}

/* Ensure labels inside bookmarks are transparent */
QWidget#bookmark QLabel {
    background: transparent;
}

/* QLineEdit styling inside bookmarks */
QWidget#bookmark QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px;
}
